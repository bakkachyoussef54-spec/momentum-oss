# Copy to .env and adjust. Never commit .env.

# SQLite database file (relative to this folder)
DATABASE_URL="file:./dev.db"

# --- Optional AI provider -------------------------------------------------
# none | openai | anthropic | openai-compatible | ollama
# You can also choose the provider, model and Ollama URL in the app (Settings → AI Mode provider);
# those choices override these defaults. API keys can ONLY be set here.
# With "none" (default) AI Mode is off; Human Mode and every manual workflow still work.
AI_PROVIDER=none

# Model id for the chosen provider (defaults: openai → gpt-4.1-mini, anthropic → claude-sonnet-4-5, ollama → qwen3:1.7b)
AI_MODEL=

# Credentials (server-side only; never exposed to the browser)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: custom OpenAI base URL (e.g. Azure/proxy)
OPENAI_BASE_URL=

# For openai-compatible servers (e.g. a local Ollama/LM Studio endpoint)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Request timeout in milliseconds (5000–300000, default 90000)
AI_TIMEOUT_MS=90000

# Optional cost estimates (USD per million tokens) — shown after generation when both are set
AI_INPUT_COST_PER_MTOK=
AI_OUTPUT_COST_PER_MTOK=

# --- Local AI with Ollama (free, no key) ----------------------------------
# Install from https://ollama.com/download, then: ollama pull qwen3:1.7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
